{% extends 'page_setup.html.twig' %}
{% block page_title %}Baustellen{% endblock %}
{% block main %}
<div class="card mb-3">
    <div class="card-body">
        <label class="form-label fw-bold" for="wtl-customer">Kunde</label>
        <select id="wtl-customer" class="form-select mb-3">
            <option value="">– Kunde auswählen –</option>
            {% for id, c in customers %}<option value="{{ id }}">{{ c.name }}</option>{% endfor %}
        </select>
        <label class="form-label fw-bold" for="wtl-project">Projekt / Baustelle</label>
        <select id="wtl-project" class="form-select" disabled>
            <option value="">– erst Kunde wählen –</option>
        </select>
        <div class="form-hint mt-2">Neue Baustelle? Einfach als Projekt anlegen (geht auch direkt beim Zeiteintrag).</div>
    </div>
</div>
<script>
(function () {
    var data = {{ customers|json_encode|raw }};
    var base = {{ path('wtl_site_project', {id: 0})|json_encode|raw }};
    var cs = document.getElementById('wtl-customer'), ps = document.getElementById('wtl-project');
    function open(id) { window.location = base.replace(/\/0$/, '/' + id); }
    cs.addEventListener('change', function () {
        var c = data[cs.value];
        ps.innerHTML = '';
        if (!c) { ps.disabled = true; ps.add(new Option('– erst Kunde wählen –', '')); return; }
        if (c.projects.length === 1) { open(c.projects[0].id); return; }
        ps.add(new Option('– Projekt auswählen –', ''));
        c.projects.forEach(function (p) { ps.add(new Option(p.name, p.id)); });
        ps.disabled = false;
        ps.focus();
    });
    ps.addEventListener('change', function () { if (ps.value) { open(ps.value); } });
})();
</script>

<a href="{{ path('wtl_site_orders') }}" class="card card-link mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div><i class="fas fa-truck me-2"></i><strong>Bestellliste</strong> <span class="text-secondary">– offenes Material nach Großhändler</span></div>
        <span class="badge {{ openCount > 0 ? 'bg-orange' : 'bg-secondary' }} text-white">{{ openCount }}</span>
    </div>
</a>

{% if visited|length > 0 %}
    <h3 class="mb-2">Zuletzt vor Ort</h3>
    <div class="list-group mb-3">
        {% for v in visited %}
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="{{ path('wtl_site_project', {id: v.project.id}) }}">
                <div>
                    <div class="fw-bold">{{ v.project.name }}</div>
                    {% if v.project.customer and v.project.customer.name != v.project.name %}<div class="text-secondary small">{{ v.project.customer.name }}</div>{% endif %}
                </div>
                <div class="text-end small text-secondary">{{ v.last|date('d.m.Y', false) }}<br>{{ v.total|duration }} h</div>
            </a>
        {% endfor %}
    </div>
{% endif %}

{% if recent|length > 0 %}
    <h3 class="mb-2">Zuletzt Zettel bearbeitet</h3>
    <div class="list-group mb-3">
        {% for r in recent %}
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="{{ path('wtl_site_project', {id: r.project_id}) }}">
                <div>
                    <div class="fw-bold">{{ r.project.name }}</div>
                    {% if r.project.customer %}<div class="text-secondary small">{{ r.project.customer.name }}</div>{% endif %}
                </div>
                <div class="text-end small text-secondary">{{ r.items }} Einträge<br>{{ r.last|date('d.m.Y', false) }}</div>
            </a>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
