{% extends 'page_setup.html.twig' %}
{% import '@WorkTimeLite/site/_macros.html.twig' as m %}
{% block page_title %}{{ titles[kind] }}{% endblock %}
{% block main %}
{% set token = csrf_token('wtl_site') %}
<style>
    .wtl-site .wtl-qty { min-width: 5.5rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .wtl-site input, .wtl-site select, .wtl-site textarea { font-size: 1rem; }
</style>
<div class="wtl-site">
<div class="d-flex gap-2 mb-3 flex-wrap">
    <a class="btn" href="{{ path('wtl_site_project', {id: project.id, kind: kind}) }}"><i class="fas fa-chevron-left me-1"></i>{{ project.name }}</a>
    {% if sheet %}<a class="btn btn-primary ms-auto" href="{{ path('wtl_site_sheet_pdf', {sid: sheet.id}) }}" target="_blank"><i class="fas fa-file-pdf me-1"></i>PDF</a>{% endif %}
</div>

{% macro head_fields(kind, sheet, today, suppliers) %}
    <div class="row g-2">
        <div class="col-6 col-md-3"><label class="form-label">Datum</label><input type="date" name="date" class="form-control" value="{{ sheet ? sheet.sheet_date : today }}"></div>
        <div class="col-6 col-md-5"><label class="form-label">Bezeichnung</label><input type="text" name="title" class="form-control" placeholder="z. B. Bad OG" value="{{ sheet ? sheet.title : '' }}"></div>
        {% if kind == 'material' %}
            <div class="col-12 col-md-4"><label class="form-label">Großhändler</label><input type="text" name="supplier" class="form-control" placeholder="z. B. Sonepar" list="wtl-suppliers" value="{{ sheet ? sheet.supplier : '' }}"></div>
        {% endif %}
    </div>
{% endmacro %}

{% macro rows(kind, defUnit) %}
    {% if kind == 'notiz' %}
        <div id="wtl-rows" data-unit="">
            <div class="wtl-line mb-1"><textarea name="rows[0][text]" class="form-control" rows="3" placeholder="Notiz"></textarea></div>
        </div>
    {% else %}
        <div id="wtl-rows" data-unit="{{ defUnit }}">
            {% for i in 0..2 %}
                <div class="wtl-line mb-2">
                    <div class="d-flex gap-1">
                        <input type="text" name="rows[{{ i }}][quantity]" class="form-control" style="max-width:5.5rem" inputmode="decimal" placeholder="Menge">
                        <input type="text" name="rows[{{ i }}][unit]" class="form-control" style="max-width:5rem" list="wtl-units" value="{{ defUnit }}">
                        <input type="text" name="rows[{{ i }}][text]" class="form-control" placeholder="{{ kind == 'aufmass' ? 'z. B. NYM-J 3x1,5 UP' : 'z. B. Schalter Gira E2' }}" list="wtl-suggest">
                    </div>
                    <input type="text" name="rows[{{ i }}][room]" class="form-control form-control-sm mt-1" placeholder="Raum / Stelle (optional)" list="wtl-rooms">
                </div>
            {% endfor %}
        </div>
    {% endif %}
    <button type="button" class="btn btn-sm w-100 mb-2" id="wtl-addrow"><i class="fas fa-plus me-1"></i>Weitere Zeile</button>
{% endmacro %}

{% if sheet is null %}
    <form method="post" autocomplete="off" class="card mb-3">
        <div class="card-header"><strong>Neue{{ kind == 'aufmass' ? 's' }} {{ kind == 'notiz' ? 'Notiz' : titles[kind] }}</strong></div>
        <div class="card-body">
            <input type="hidden" name="_token" value="{{ token }}">
            {{ _self.head_fields(kind, null, today, suppliers) }}
            <hr class="my-3">
            {{ _self.rows(kind, defUnit) }}
            <button class="btn btn-primary w-100"><i class="fas fa-save me-1"></i>Speichern</button>
        </div>
    </form>
{% else %}
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="h2 mb-0">{{ titles[kind] }} vom {{ sheet.sheet_date|date('d.m.Y', false) }}</div>
                    <div class="text-secondary">{{ sheet.title }}{% if sheet.title and sheet.supplier %} · {% endif %}{{ sheet.supplier }}</div>
                </div>
                <button class="btn btn-sm btn-ghost-secondary" type="button" onclick="document.getElementById('wtl-head').classList.toggle('d-none')" title="Kopf bearbeiten"><i class="fas fa-pen"></i></button>
            </div>
            <form method="post" id="wtl-head" class="d-none mt-3">
                <input type="hidden" name="_token" value="{{ token }}">
                <input type="hidden" name="edit_head" value="1">
                {{ _self.head_fields(kind, sheet, today, suppliers) }}
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-primary flex-fill">Übernehmen</button>
                </div>
            </form>
        </div>
        <div class="list-group list-group-flush">
            {% for item in items %}
                <div class="list-group-item py-2 d-flex gap-2 align-items-center">
                    {% if kind != 'notiz' %}<div class="wtl-qty">{{ m.qty(item) }}</div>{% endif %}
                    <div class="flex-fill" style="word-break: break-word">
                        <div style="white-space: pre-line">{{ item.text }}</div>
                        {% if item.room %}<div class="small text-secondary">{{ item.room }}</div>{% endif %}
                    </div>
                    {% if kind == 'material' %}
                        <form method="post" action="{{ path('wtl_site_item_status', {id: item.id}) }}">
                            <input type="hidden" name="_token" value="{{ token }}">
                            {% set next = {offen: 'bestellt', bestellt: 'geliefert', geliefert: 'offen'} %}
                            <input type="hidden" name="status" value="{{ next[item.status]|default('offen') }}">
                            <button class="btn btn-sm btn-ghost-secondary p-1" title="Weiter auf: {{ next[item.status]|default('offen') }}">{{ m.status_badge(item.status) }}</button>
                        </form>
                    {% endif %}
                    <form method="post" action="{{ path('wtl_site_item_delete', {id: item.id}) }}" onsubmit="return confirm('Position löschen?')">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <button class="btn btn-sm btn-ghost-danger p-1" title="Löschen"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            {% else %}
                <div class="list-group-item text-secondary">Noch keine Positionen.</div>
            {% endfor %}
        </div>
    </div>

    <form method="post" autocomplete="off" class="card mb-3">
        <div class="card-header"><strong>Positionen hinzufügen</strong></div>
        <div class="card-body">
            <input type="hidden" name="_token" value="{{ token }}">
            {{ _self.rows(kind, defUnit) }}
            <button class="btn btn-primary w-100"><i class="fas fa-save me-1"></i>Hinzufügen</button>
        </div>
    </form>

    <form method="post" action="{{ path('wtl_site_sheet_delete', {sid: sheet.id}) }}" onsubmit="return confirm('Ganzen Zettel mit allen Positionen löschen?')" class="text-end mb-3">
        <input type="hidden" name="_token" value="{{ token }}">
        <button class="btn btn-ghost-danger btn-sm"><i class="fas fa-trash me-1"></i>Zettel löschen</button>
    </form>
{% endif %}

<datalist id="wtl-units">{% for u in units %}<option value="{{ u }}">{% endfor %}</datalist>
<datalist id="wtl-suggest">{% for s in suggestions %}<option value="{{ s }}">{% endfor %}</datalist>
<datalist id="wtl-suppliers">{% for s in suppliers %}<option value="{{ s }}">{% endfor %}</datalist>
<datalist id="wtl-rooms">{% for i in items %}{% if i.room %}<option value="{{ i.room }}">{% endif %}{% endfor %}</datalist>
</div>
<script>
(function () {
    var box = document.getElementById('wtl-rows'), btn = document.getElementById('wtl-addrow');
    if (!box || !btn) { return; }
    function addRow() {
        var lines = box.querySelectorAll('.wtl-line'), last = lines[lines.length - 1];
        var n = lines.length, row = last.cloneNode(true);
        row.querySelectorAll('input, textarea').forEach(function (inp) {
            inp.name = inp.name.replace(/rows\[\d+\]/, 'rows[' + n + ']');
            if (/\[unit\]$/.test(inp.name)) { inp.value = last.querySelector('[name$="[unit]"]').value || box.dataset.unit; }
            else if (/\[room\]$/.test(inp.name)) { inp.value = last.querySelector('[name$="[room]"]').value; }
            else { inp.value = ''; }
        });
        box.appendChild(row);
        return row;
    }
    btn.addEventListener('click', function () { addRow().querySelector('input, textarea').focus(); });
    box.addEventListener('input', function (e) {
        var lines = box.querySelectorAll('.wtl-line'), last = lines[lines.length - 1];
        if (last.contains(e.target) && e.target.value !== '' && !/\[(unit|room)\]$/.test(e.target.name)) { addRow(); }
    });
    box.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' || e.target.tagName === 'TEXTAREA') { return; }
        e.preventDefault();
        var line = e.target.closest('.wtl-line'), next = line.nextElementSibling;
        if (next) { next.querySelector('input').focus(); }
    });
})();
</script>
{% endblock %}
