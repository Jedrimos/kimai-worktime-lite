{% extends 'page_setup.html.twig' %}
{% block page_title %}{{ project.name }}{% endblock %}
{% block main %}
<div class="d-flex gap-2 mb-3 flex-wrap">
    <a class="btn" href="{{ path('wtl_site') }}"><i class="fas fa-chevron-left me-1"></i>Baustellen</a>
    <a class="btn" href="{{ path('wtl_site_orders') }}"><i class="fas fa-truck me-1"></i>Bestellliste</a>
    <a class="btn ms-auto" href="{{ path('wtl_site_project_pdf', {id: project.id}) }}" target="_blank" title="Alle Zettel in einem PDF"><i class="fas fa-file-pdf me-1"></i>Alles</a>
</div>
{% if project.customer and project.customer.name != project.name and not overview %}<div class="text-secondary mb-2">{{ project.customer.name }}</div>{% endif %}

<ul class="nav nav-tabs nav-fill">
    <li class="nav-item"><a class="nav-link fw-bold {{ kind == 'overview' ? 'active' }}" href="{{ path('wtl_site_project', {id: project.id}) }}"><i class="fas fa-info-circle"></i><span class="d-none d-md-inline ms-1">Übersicht</span></a></li>
    {% for k, label in kinds %}
        <li class="nav-item"><a class="nav-link fw-bold {{ k == kind ? 'active' }}" href="{{ path('wtl_site_project', {id: project.id, kind: k}) }}">{{ label }} <span class="badge ms-1">{{ counts[k] }}</span></a></li>
    {% endfor %}
</ul>
{% if overview %}
{% set o = overview %}
{% set token = csrf_token('wtl_site') %}
{% set back = path('wtl_site_project', {id: project.id}) %}
<div class="card mb-3" style="border-top-left-radius:0;border-top-right-radius:0">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div class="h2 mb-1">{{ project.name }}</div>
            {% if o.useStatus %}
                {% set sc = {geplant: 'bg-secondary', laeuft: 'bg-green', fertig: 'bg-blue', abgerechnet: 'bg-dark'} %}
                <div class="dropdown">
                    <button class="btn btn-sm dropdown-toggle {{ o.meta.status ? sc[o.meta.status] ~ ' text-white' }}" data-bs-toggle="dropdown" type="button">{{ o.meta.status ? o.statusLabels[o.meta.status] : 'Status' }}</button>
                    <div class="dropdown-menu dropdown-menu-end">
                        {% for k, l in o.statusLabels %}
                            <form method="post" action="{{ path('wtl_site_meta', {id: project.id}) }}">
                                <input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="back" value="{{ back }}"><input type="hidden" name="status" value="{{ k }}">
                                <button class="dropdown-item {{ o.meta.status == k ? 'active' }}">{{ l }}</button>
                            </form>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
        {% if o.customer and o.customer.name != project.name %}<div class="fw-bold">{{ o.customer.name }}{% if o.customer.company and o.customer.company != o.customer.name %} · {{ o.customer.company }}{% endif %}</div>{% endif %}
        {% if o.address %}<div class="text-secondary" style="white-space: pre-line">{{ o.address }}</div>{% endif %}
        {% if o.customer and o.customer.contact %}<div class="mt-2"><i class="fas fa-user me-1 text-secondary"></i>{{ o.customer.contact }}</div>{% endif %}
        <div class="d-flex flex-wrap gap-2 mt-3">
            {% if o.mapsQuery %}<a class="btn btn-primary flex-fill" href="https://www.google.com/maps/dir/?api=1&destination={{ o.mapsQuery|url_encode }}" target="_blank" rel="noopener"><i class="fas fa-route me-1"></i>Navigation</a>{% endif %}
            {% if o.phone %}<a class="btn btn-success flex-fill" href="tel:{{ o.phone|replace({' ': '', '/': '', '-': ''}) }}"><i class="fas fa-phone me-1"></i>{{ o.phone }}</a>{% endif %}
            {% if o.phone2 %}<a class="btn flex-fill" href="tel:{{ o.phone2|replace({' ': '', '/': '', '-': ''}) }}"><i class="fas fa-phone me-1"></i>{{ o.phone2 }}</a>{% endif %}
            {% if o.customer and o.customer.email %}<a class="btn flex-fill" href="mailto:{{ o.customer.email }}"><i class="fas fa-envelope me-1"></i>Mail</a>{% endif %}
        </div>
    </div>
</div>

{% if project.orderNumber or project.comment or (o.customer and o.customer.comment) %}
<div class="card mb-3">
    <div class="card-header py-2"><strong>Infos</strong></div>
    <div class="card-body">
        {% if project.orderNumber %}<div><span class="text-secondary">Auftrag:</span> {{ project.orderNumber }}</div>{% endif %}
        {% if project.comment %}<div class="mt-1" style="white-space: pre-line">{{ project.comment }}</div>{% endif %}
        {% if o.customer and o.customer.comment %}<div class="mt-2 small text-secondary" style="white-space: pre-line">{{ o.customer.comment }}</div>{% endif %}
    </div>
</div>
{% endif %}

<div class="row g-2 mb-3">
    <div class="col-4"><div class="card"><div class="card-body p-2 text-center"><div class="text-secondary small">Meine Stunden</div><div class="h2 mb-0">{{ (o.stats.total ?? 0)|duration }}</div></div></div></div>
    <div class="col-4"><div class="card"><div class="card-body p-2 text-center"><div class="text-secondary small">Tage vor Ort</div><div class="h2 mb-0">{{ o.stats.days ?? 0 }}</div></div></div></div>
    <a class="col-4" href="{{ path('wtl_site_project', {id: project.id, kind: 'material'}) }}" style="text-decoration:none"><div class="card"><div class="card-body p-2 text-center"><div class="text-secondary small">Material offen</div><div class="h2 mb-0 {{ o.openMaterial > 0 ? 'text-orange' }}">{{ o.openMaterial }}</div></div></div></a>
</div>
{% if o.with|length > 0 %}<div class="small mb-2"><i class="fas fa-user-friends me-1 text-secondary"></i>Mit dabei: {% for n, c in o.with %}<a href="{{ path('wtl_person', {name: n, period: 'year'}) }}">{{ n }}</a> ({{ c }}×){{ not loop.last ? ', ' }}{% endfor %}</div>{% endif %}
{% if o.stats.first %}<div class="text-secondary small mb-2">Erster Tag {{ o.stats.first|date('d.m.Y', false) }} · zuletzt {{ o.stats.last|date('d.m.Y', false) }}</div>{% endif %}

<div class="d-flex gap-2 mb-3 flex-wrap">
    {% for k, label in kinds %}
        <a class="btn flex-fill" href="{{ path('wtl_site_sheet_new', {id: project.id, kind: k}) }}"><i class="fas fa-plus me-1"></i>{{ label }}</a>
    {% endfor %}
    {% if o.useCircuits %}<a class="btn flex-fill" href="{{ path('wtl_site_circuits', {id: project.id}) }}"><i class="fas fa-th me-1"></i>Stromkreise{% if o.circuitCount > 0 %} <span class="badge ms-1">{{ o.circuitCount }}</span>{% endif %}</a>{% endif %}
</div>

{% if o.useAccess %}
<details class="card mb-3" {{ o.meta.access_info ? '' : '' }}>
    <summary class="card-body py-2 d-flex align-items-center gap-2" style="list-style:none;cursor:pointer">
        <i class="fas fa-key text-warning"></i>
        {% if o.meta.access_info %}<span class="flex-fill" style="white-space:pre-line">{{ o.meta.access_info }}</span>{% else %}<span class="flex-fill text-secondary">Zugang / Schlüssel / Code eintragen</span>{% endif %}
        <i class="fas fa-pen small text-secondary"></i>
    </summary>
    <form method="post" action="{{ path('wtl_site_meta', {id: project.id}) }}" class="card-body pt-0">
        <input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="back" value="{{ back }}">
        <textarea name="access_info" class="form-control mb-2" rows="2" placeholder="z. B. Schlüsselbox Code 1234, bei Nachbar klingeln, Hund!" data-wtl-dictate>{{ o.meta.access_info }}</textarea>
        <button class="btn btn-primary btn-sm w-100">Speichern</button>
    </form>
</details>
{% endif %}
{% if o.todos is not null %}
    {% include '@WorkTimeLite/site/_todo_card.html.twig' with {project: project, todos: o.todos, back: path('wtl_site_project', {id: project.id}), token: token} only %}
{% endif %}

{% if o.photos is not null %}
<div class="card mb-3">
    <a class="card-header py-2 d-flex text-reset" href="{{ path('wtl_site_photos', {id: project.id}) }}"><strong><i class="fas fa-camera me-2"></i>Fotos</strong><span class="badge ms-2">{{ o.photoCount }}</span><span class="ms-auto small text-primary">{{ o.photoCount > 0 ? 'alle / neu' : 'Foto machen' }} ›</span></a>
    {% if o.photos|length > 0 %}
    <div class="card-body p-2 d-flex gap-2 overflow-auto">
        {% for ph in o.photos %}<a href="{{ path('wtl_site_photos', {id: project.id}) }}"><img src="{{ path('wtl_site_photo', {pid: ph.id}) }}" loading="lazy" style="height:72px;width:96px;object-fit:cover;border-radius:4px"></a>{% endfor %}
    </div>
    {% endif %}
</div>
{% endif %}

<div class="card mb-3">
    <div class="card-header py-2 d-flex"><strong>Zettel auf dieser Baustelle</strong>
        {% if o.sheets|length > 0 %}<a class="ms-auto small" href="{{ path('wtl_site_project_pdf', {id: project.id}) }}" target="_blank"><i class="fas fa-file-pdf me-1"></i>alle als PDF</a>{% endif %}
    </div>
    <div class="list-group list-group-flush">
        {% set icons = {aufmass: 'fa-ruler-combined', material: 'fa-boxes', notiz: 'fa-sticky-note'} %}
        {% for sheet in o.sheets %}
            <a class="list-group-item list-group-item-action py-2 d-flex align-items-center gap-2" href="{{ path('wtl_site_sheet', {sid: sheet.id}) }}">
                <i class="fas {{ icons[sheet.kind] }} text-secondary" style="width:1.3rem"></i>
                <div class="flex-fill">
                    <div class="fw-bold">{{ titles[sheet.kind] }}{% if sheet.title %} – {{ sheet.title }}{% endif %}</div>
                    <div class="small text-secondary">{{ sheet.sheet_date|date('d.m.Y', false) }}{% if sheet.supplier %} · {{ sheet.supplier }}{% endif %}</div>
                </div>
                <span class="badge">{{ sheet.items }} Pos.</span>
                {% if sheet.kind == 'material' %}
                    {% if sheet.open_items > 0 %}<span class="badge bg-orange-lt">{{ sheet.open_items }} offen</span>{% elseif sheet.items > 0 %}<span class="badge bg-green-lt">✓</span>{% endif %}
                {% endif %}
            </a>
        {% else %}
            <div class="list-group-item text-secondary">Noch keine Aufmaße, Bestellungen oder Notizen.</div>
        {% endfor %}
    </div>
</div>

{% if o.recent|length > 0 %}
<div class="card mb-3">
    <div class="card-header py-2"><strong>Meine letzten Einsätze</strong></div>
    <div class="list-group list-group-flush">
        {% for t in o.recent %}
            <div class="list-group-item py-2">
                <div class="d-flex justify-content-between">
                    <span class="fw-bold">{{ t.begin|date('D d.m.Y', false)|replace({Mon:'Mo',Tue:'Di',Wed:'Mi',Thu:'Do',Fri:'Fr',Sat:'Sa',Sun:'So'}) }}</span>
                    <span>{{ t.begin|date('H:i', false) }}–{{ t.end ? t.end|date('H:i', false) : 'läuft' }} · {{ t.duration|duration }}</span>
                </div>
                <div class="small text-secondary d-flex"><span class="flex-fill">{{ t.activity ? t.activity.name }}{% if t.description %} · {{ t.description|u.truncate(80, '…') }}{% endif %}</span>{% if t.end %}<a href="{{ path('wtl_report_day', {date: t.begin|date('Y-m-d', false), project: project.id}) }}" title="Baustellenbericht"><i class="fas fa-file-signature"></i></a>{% endif %}</div>
            </div>
        {% endfor %}
    </div>
</div>
{% endif %}
{% else %}
<div class="card mb-3" style="border-top-left-radius:0;border-top-right-radius:0">
    <div class="card-body">
        <a class="btn btn-primary w-100" href="{{ path('wtl_site_sheet_new', {id: project.id, kind: kind}) }}"><i class="fas fa-plus me-1"></i>Neue{{ kind == 'aufmass' ? 's' }} {{ titles[kind] == 'Notizen' ? 'Notiz' : titles[kind] }}</a>
    </div>
</div>

{% for sheet in sheets %}
    <a class="card card-link mb-2" href="{{ path('wtl_site_sheet', {sid: sheet.id}) }}">
        <div class="card-body py-2 d-flex justify-content-between align-items-center gap-2">
            <div>
                <div class="fw-bold">{{ titles[sheet.kind] }} vom {{ sheet.sheet_date|date('d.m.Y', false) }}</div>
                <div class="small text-secondary">{{ sheet.title }}{% if sheet.title and sheet.supplier %} · {% endif %}{{ sheet.supplier }}</div>
            </div>
            <div class="text-end">
                <span class="badge">{{ sheet.items }} Pos.</span>
                {% if sheet.kind == 'material' and sheet.open_items > 0 %}<br><span class="badge bg-orange-lt mt-1">{{ sheet.open_items }} offen</span>{% endif %}
            </div>
        </div>
    </a>
{% else %}
    <div class="text-secondary text-center py-3">Noch nichts angelegt.</div>
{% endfor %}
{% endif %}
{% endblock %}
