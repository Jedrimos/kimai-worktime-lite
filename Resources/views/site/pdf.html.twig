{% import '@WorkTimeLite/site/_macros.html.twig' as m %}
<html><head><meta charset="utf-8"><style>
body { font-family: sans-serif; font-size: 10pt; }
.doctitle { font-size: 20pt; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1mm solid #000; padding-bottom: 2mm; margin-bottom: 3mm; }
h1 { font-size: 13pt; margin: 0 0 2mm 0; }
h2 { font-size: 12pt; margin: 6mm 0 2mm 0; border-bottom: 1px solid #333; }
.meta { color: #555; margin-bottom: 4mm; }
table { width: 100%; border-collapse: collapse; }
th, td { border-bottom: 0.2mm solid #bbb; padding: 1.5mm 1mm; text-align: left; vertical-align: top; }
th { background: #eee; }
td.q { width: 22mm; text-align: right; white-space: nowrap; font-weight: bold; }
td.day { background: #f4f4f4; font-weight: bold; padding-top: 2.5mm; }
td.c { width: 8mm; }
.box { display: inline-block; width: 4mm; height: 4mm; border: 0.3mm solid #333; }
</style></head><body>
{% if mode == 'project' %}
    <div class="doctitle">{{ title }}</div>
    <h1>Baustelle: {{ project.name }}</h1>
    <div class="meta">{% if project.customer %}Kunde: {{ project.customer.name }} · {% endif %}{{ user.displayName }} · Stand {{ now|date('d.m.Y H:i', false) }}</div>
    {% for sheet in sheets %}
        {% set kind = sheet.kind %}
        <h2>{{ titles[kind] }} vom {{ sheet.sheet_date|date('d.m.Y', false) }}{% if sheet.title %} – {{ sheet.title }}{% endif %}{% if sheet.supplier %} · {{ sheet.supplier }}{% endif %}</h2>
        <table>
            <tr>{% if kind != 'notiz' %}<th style="text-align:right">Menge</th>{% endif %}<th>{{ kind == 'notiz' ? 'Notiz' : 'Bezeichnung' }}</th><th>Raum / Stelle</th>{% if kind == 'material' %}<th>Status</th>{% endif %}</tr>
            {% for item in sheet.items_list %}
                <tr>
                    {% if kind != 'notiz' %}<td class="q">{{ m.qty(item) }}</td>{% endif %}
                    <td>{{ item.text|nl2br }}</td>
                    <td>{{ item.room }}</td>
                    {% if kind == 'material' %}<td>{{ item.status }}</td>{% endif %}
                </tr>
            {% endfor %}
        </table>
    {% else %}
        <p>Noch keine Einträge.</p>
    {% endfor %}
    {% if photos is defined and photos|length > 0 %}
        <h2>Fotos</h2>
        <table class="photos">
            {% for row in photos|batch(2) %}
                <tr>
                    {% for ph in row %}
                        <td style="width:50%; border:none; text-align:center; padding:2mm">
                            <img src="{{ ph.path }}" style="width:82mm; max-height:62mm">
                            <div style="font-size:8pt; color:#555">{% if ph.kind|default('foto') == 'zaehler' %}<b>Zähler</b> {% elseif ph.kind|default('foto') == 'typenschild' %}<b>Typenschild</b> {% endif %}{% if ph.meter_no|default(null) %}{{ ph.meter_no }} {% endif %}{% if ph.reading|default(null) %}· {{ ph.reading }} {% endif %}<br>{{ ph.created_at|date('d.m.Y H:i', false) }}{% if ph.comment %} – {{ ph.comment }}{% endif %}</div>
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </table>
    {% endif %}
{% else %}
    <div class="doctitle">Materialbestellung</div>
    <h1>Bestellliste – alle Baustellen</h1>
    <div class="meta">{{ user.displayName }} · Stand {{ now|date('d.m.Y H:i', false) }}</div>
    {% for supplier, items in groups %}
        <h2>{{ supplier }}</h2>
        <table>
            <tr><th class="c"></th><th style="text-align:right">Menge</th><th>Bezeichnung</th><th>Baustelle</th><th>Status</th></tr>
            {% for item in items %}
                <tr><td class="c"><span class="box"></span></td><td class="q">{{ m.qty(item) }}</td><td>{{ item.text }}</td><td>{{ item.project ? item.project.name : '' }}{% if item.room %} ({{ item.room }}){% endif %}</td><td>{{ item.status }}</td></tr>
            {% endfor %}
        </table>
    {% else %}
        <p>Kein offenes Material.</p>
    {% endfor %}
{% endif %}
</body></html>
