{% extends '@WorkTimeLite/_base.html.twig' %}
{% block page_title %}Gewerbe {{ year }}{% endblock %}
{% block wtl %}
{% include '@WorkTimeLite/business/_nav.html.twig' with {active: 'overview', year: year} only %}
{% set e = 'de' %}
{% macro eur(v) %}{{ v|number_format(2, ',', '.') }} €{% endmacro %}
{% import _self as m %}
<div class="row g-3 mb-3">
    <div class="col-lg-5">
        {% set a = ampel %}
        {% set colors = {green: 'bg-success', yellow: 'bg-warning', red: 'bg-danger'} %}
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <strong><i class="fas fa-traffic-light me-1"></i>Kleinunternehmer-Grenze</strong>
                    <span class="badge {{ colors[a.color] }} text-white">{{ a.pct|round }} %</span>
                </div>
                <div class="h1 mb-0">{{ m.eur(income) }}</div>
                <div class="text-secondary small mb-2">Umsatz {{ year }} (netto) von {{ m.eur(a.limit) }}{{ a.founding ? ' – Gründungsjahr' : '' }}</div>
                <div class="progress mb-2" style="height:.7rem"><div class="progress-bar {{ colors[a.color] }}" style="width: {{ a.pct }}%"></div></div>
                <div class="small">Noch <strong>{{ m.eur(a.rest) }}</strong> Luft bis zur Grenze.</div>
                {% if not a.founding %}
                    <div class="small mt-1 {{ a.next25 >= 100 ? 'text-danger' : 'text-secondary' }}">Für {{ year + 1 }}: {{ a.next25 >= 100 ? '25.000 € überschritten – nächstes Jahr Umsatzsteuer!' : 'noch ' ~ m.eur(25000 - income > 0 ? 25000 - income : 0) ~ ' bis 25.000 €' }}</div>
                    {% if a.prevOver %}<div class="alert alert-danger py-1 px-2 mt-2 small">Vorjahr über 25.000 € → {{ year }} keine Kleinunternehmerregelung.</div>{% endif %}
                {% endif %}
                <div class="form-hint mt-2">Grenzen nach § 19 UStG: im Gründungsjahr 25.000 €, danach 25.000 € Vorjahr und 100.000 € laufendes Jahr. Gezählt werden bezahlte Rechnungen (Zahlungsdatum) und Einnahmen ohne Rechnung. Hilfsanzeige – im Zweifel Steuerberater.</div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="row g-2 h-100">
            <div class="col-6"><div class="card h-100"><div class="card-body p-3"><div class="small text-secondary">Einnahmen</div><div class="h2 mb-0 text-success">{{ m.eur(income) }}</div></div></div></div>
            <div class="col-6"><div class="card h-100"><div class="card-body p-3"><div class="small text-secondary">Ausgaben</div><div class="h2 mb-0 text-danger">{{ m.eur(expense) }}</div></div></div></div>
            <div class="col-6"><div class="card h-100"><div class="card-body p-3"><div class="small text-secondary">Fahrten ({{ km|number_format(0, ',', '.') }} km × {{ kmRate|number_format(2, ',', '.') }} €)</div><div class="h2 mb-0 text-danger">{{ m.eur(trip) }}</div></div></div></div>
            <div class="col-6"><div class="card h-100"><div class="card-body p-3"><div class="small text-secondary">Gewinn (EÜR)</div><div class="h2 mb-0">{{ m.eur(profit) }}</div></div></div></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header py-2 d-flex"><strong>Monate</strong><a class="ms-auto btn btn-sm" href="{{ path('wtl_business_csv', {year: year}) }}"><i class="fas fa-file-csv me-1"></i>EÜR als CSV</a></div>
            <table class="table table-sm card-table table-vcenter mb-0">
                <thead><tr><th>Monat</th><th class="text-end">Einnahmen</th><th class="text-end">Ausgaben</th><th class="text-end">Fahrten</th><th class="text-end">Ergebnis</th></tr></thead>
                <tbody>
                {% set mn = ['', 'Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'] %}
                {% for mo, r in months %}{% if r.income or r.expense or r.trip %}
                    <tr><td>{{ mn[mo] }}</td><td class="text-end">{{ r.income|number_format(2, ',', '.') }}</td><td class="text-end">{{ r.expense|number_format(2, ',', '.') }}</td><td class="text-end">{{ r.trip|number_format(2, ',', '.') }}</td><td class="text-end fw-bold">{{ (r.income - r.expense - r.trip)|number_format(2, ',', '.') }}</td></tr>
                {% endif %}{% else %}{% endfor %}
                {% if income == 0 and expense == 0 and trip == 0 %}<tr><td colspan="5" class="text-secondary">Noch nichts in {{ year }}.</td></tr>{% endif %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header py-2"><strong>Offene Rechnungen</strong><span class="badge ms-2">{{ open|length }}</span></div>
            <div class="list-group list-group-flush">
                {% for inv in open %}
                    {% set due = inv.created_at|date_modify('+' ~ inv.due_days ~ ' days') %}
                    <div class="list-group-item py-2 d-flex justify-content-between">
                        <span><strong>{{ inv.invoice_number }}</strong> · {{ inv.customer }}<br><span class="small {{ due < date() ? 'text-danger' : 'text-secondary' }}">fällig {{ due|date('d.m.Y') }}</span></span>
                        <strong>{{ m.eur(inv.total) }}</strong>
                    </div>
                {% else %}
                    <div class="list-group-item text-secondary">Keine offenen Rechnungen.</div>
                {% endfor %}
            </div>
        </div>
        <details class="card">
            <summary class="card-body py-2" style="cursor:pointer"><i class="fas fa-cog me-1"></i><strong>Einstellungen</strong></summary>
            <form method="post" action="{{ path('wtl_business_settings') }}" class="card-body pt-0">
                <input type="hidden" name="_token" value="{{ csrf_token('wtl_business') }}">
                <div class="mb-2"><label class="form-label">Gründungsjahr</label><input type="number" name="founded" class="form-control" value="{{ founded }}"></div>
                <div class="mb-2"><label class="form-label">Umsatz Vorjahr (falls nicht hier erfasst)</label><input type="text" name="prev_revenue" class="form-control" inputmode="decimal" value="{{ ampel.prev is not null ? ampel.prev|number_format(2, ',', '') : '' }}" placeholder="leer = aus Kimai berechnen"></div>
                <div class="mb-2"><label class="form-label">Kilometersatz (€/km)</label><input type="text" name="km_rate" class="form-control" inputmode="decimal" value="{{ kmRate|number_format(2, ',', '') }}"></div>
                <button class="btn btn-primary w-100">Speichern</button>
            </form>
        </details>
    </div>
</div>
{% endblock %}
