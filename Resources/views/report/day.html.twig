{% extends 'page_setup.html.twig' %}
{% block page_title %}Baustellenbericht{% endblock %}
{% block main %}
<form method="post" target="_blank" class="card mb-3">
    <div class="card-body">
        <div class="mb-2"><label class="form-label">Baustelle</label><input type="text" name="site" class="form-control" value="{{ data.site }}"></div>
        <div class="row g-2 mb-2">
            <div class="col-5"><label class="form-label">Datum</label><input type="text" class="form-control" value="{{ data.date|date('d.m.Y') }}" disabled></div>
            <div class="col-3"><label class="form-label">Tag</label><input type="text" class="form-control" value="{{ data.weekday|slice(0, 2) }}" disabled></div>
            <div class="col-4"><label class="form-label">Stunden</label><input type="text" name="hours" class="form-control" inputmode="decimal" value="{{ data.hours|number_format(2, ',', '') }}"></div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-6">
                <label class="form-label">Aufmaß</label>
                <div class="btn-group w-100">
                    <input type="radio" class="btn-check" name="aufmass" id="a1" value="ja" {{ data.aufmass ? 'checked' }}><label class="btn" for="a1">ja</label>
                    <input type="radio" class="btn-check" name="aufmass" id="a2" value="nein" {{ not data.aufmass ? 'checked' }}><label class="btn" for="a2">nein</label>
                </div>
            </div>
            <div class="col-6">
                <label class="form-label">Regiebericht</label>
                <div class="btn-group w-100">
                    <input type="radio" class="btn-check" name="regie" id="r1" value="ja" {{ data.regie ? 'checked' }}><label class="btn" for="r1">ja</label>
                    <input type="radio" class="btn-check" name="regie" id="r2" value="nein" {{ not data.regie ? 'checked' }}><label class="btn" for="r2">nein</label>
                </div>
            </div>
        </div>
        <label class="form-label">Tätigkeit</label>
        <textarea name="text" class="form-control mb-3" rows="7" data-wtl-dictate>{{ data.text }}</textarea>
        <button class="btn btn-primary btn-lg w-100"><i class="fas fa-file-pdf me-2"></i>PDF erstellen</button>
        {% if not hasSignature %}<div class="form-hint mt-2"><a href="{{ path('wtl_report_setup') }}">Unterschrift einmal malen</a>, dann steht sie automatisch drin.</div>{% endif %}
    </div>
</form>
{% if others|length > 0 %}
    <div class="small text-secondary mb-1">Am selben Tag außerdem:</div>
    {% for pid, g in others %}<a class="btn btn-sm mb-1" href="{{ path('wtl_report_day', {date: data.date|date('Y-m-d'), project: pid}) }}">{{ g.project.name }}</a> {% endfor %}
{% endif %}
<a class="btn w-100 mt-2" href="{{ path('wtl_report', {month: data.date|date('Y-m-01')}) }}"><i class="fas fa-list me-1"></i>Alle Berichte</a>
{% endblock %}
