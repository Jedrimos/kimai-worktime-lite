{% extends '@WorkTimeLite/_base.html.twig' %}
{% set wtl_width = 'narrow' %}
{% block page_title %}Mit wem{% endblock %}
{% block wtl %}
{% include '@WorkTimeLite/people/_period.html.twig' with {route: 'wtl_people', extra: {}, period: period, from: from} only %}
<div class="list-group mb-3">
    {% for n, c in counts %}
        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" href="{{ path('wtl_person', {name: n, period: period, date: from|date('Y-m-d')}) }}">
            <div><i class="fas fa-user me-2 text-secondary"></i><strong>{{ n }}</strong></div>
            <div class="text-end small text-secondary">{{ c.days|length }} Tage<br>{{ c.seconds|duration }} h</div>
        </a>
    {% else %}
        <div class="list-group-item text-secondary">Noch keine Namen. Beim Zeiteintrag im Feld „Mit wem“ einfach einen Namen tippen und anlegen.</div>
    {% endfor %}
</div>
{% if own|length > 0 %}
<details class="card mb-3">
    <summary class="card-body py-2" style="cursor:pointer"><strong>Namen verwalten</strong> <span class="badge ms-1">{{ own|length }}</span></summary>
    <div class="list-group list-group-flush">
        {% for n in own %}
            <div class="list-group-item py-2 d-flex align-items-center">
                <span class="flex-fill">{{ n }}</span>
                <form method="post" action="{{ path('wtl_people_remove') }}" onsubmit="return confirm('Name aus der Auswahl entfernen? Bisherige Einträge bleiben.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('wtl_people') }}"><input type="hidden" name="name" value="{{ n }}">
                    <button class="btn btn-sm btn-ghost-danger p-1"><i class="fas fa-times"></i></button>
                </form>
            </div>
        {% endfor %}
    </div>
</details>
{% endif %}
{% endblock %}
