<html><head><meta charset="utf-8"><style>
body { font-family: sans-serif; font-size: 10pt; }
.doctitle { font-size: 18pt; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1mm solid #000; padding-bottom: 2mm; margin-bottom: 3mm; }
.meta { color: #555; margin-bottom: 4mm; }
h2 { font-size: 12pt; margin: 5mm 0 1.5mm 0; }
table { width: 100%; border-collapse: collapse; }
th, td { border-bottom: 0.2mm solid #bbb; padding: 1.5mm 1mm; text-align: left; vertical-align: top; }
th { background: #eee; }
</style></head><body>
{% set wd = {Mon:'Mo',Tue:'Di',Wed:'Mi',Thu:'Do',Fri:'Fr',Sat:'Sa',Sun:'So'} %}
<div class="doctitle">Einsätze mit {{ name }}</div>
<div class="meta">Zeitraum {{ from|date('d.m.Y') }} – {{ to|date('d.m.Y') }} · zusammen mit {{ user.displayName }} · {{ dayCount }} Tage, {{ total|duration }} h</div>
{% for week, days in weeks %}
    <h2>KW {{ week|split('-')|last }}</h2>
    <table>
        <tr><th style="width:24mm">Tag</th><th style="width:24mm">Zeit</th><th>Baustelle / Tätigkeit</th><th style="width:14mm">Std.</th></tr>
        {% for d, day in days %}{% for t in day.entries %}
            <tr>
                <td>{% if loop.first %}{{ wd[day.date|date('D')] }} {{ day.date|date('d.m.') }}{% endif %}</td>
                <td>{{ t.begin|date('H:i', false) }}–{{ t.end ? t.end|date('H:i', false) }}</td>
                <td>{{ t.project ? t.project.name }}{% if t.activity %} · {{ t.activity.name }}{% endif %}{% if t.description %}<br><span style="color:#555">{{ t.description|nl2br }}</span>{% endif %}</td>
                <td>{{ t.duration|duration }}</td>
            </tr>
        {% endfor %}{% endfor %}
    </table>
{% else %}
    <p>Keine gemeinsamen Einsätze in diesem Zeitraum.</p>
{% endfor %}
</body></html>
